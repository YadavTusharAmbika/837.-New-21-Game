class Solution {
public:
    double new21Game(int n, int k, int maxPts) {
        vector<double> P(n+1,0.0);

        //p[i] =prob of getting score = 1

        P[0]=1; // score = 0 intially 

        for (int i = 1 ; i <=n ; i++ ){
            for (int card = 1 ;  card <= maxPts; card++){

                // prob of score card = 1/maxpts
                // remaining score is = P[i-card]
                if (i - card >= 0&& i - card<k)

                P[i]+= P[i-card]/ maxPts;

            }

        }

        //k to n tak ka prob add karna hai 
        return accumulate(begin(P)+k, end(P),0.0);
    }
};
